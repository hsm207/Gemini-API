LI.\",[[12,22,[[null,null,null,null,3]]],[159,168,[[null,null,null,null,3]]],[200,202,[[null,null,null,null,3]]]]]],[null,[null,0,\"Run this command in your terminal:\"]],[null,null,null,[\"gh api repos/HanaokaYuzu/Gemini-API/contents/src/gemini_webapi/client.py --jq .content | base64 -d | grep -n -C 5 \\\"watchdog\\\"\\n\",\"bash\"]],[null,[null,0,\"or search for the timeouts defined on GeminiClient:\",[[38,50,[[null,null,null,null,3]]]]]],[null,null,null,[\"gh api repos/HanaokaYuzu/Gemini-API/contents/src/gemini_webapi/client.py --jq .content | base64 -d | grep -n -C 5 \\\"timeout\\\"\\n\",\"bash\"]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"What luuquangvu is Arguing vs. What You Are Experiencing\",[[5,15,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Where luuquangvu is coming from:\",[[6,16,[[null,null,null,null,3]]],[0,32,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"He believes the library defaults to:\"]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"watchdog_timeout \\u003d 120 seconds\",[[0,22,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"timeout \\u003d 450 seconds\",[[0,13,[[null,null,null,null,3]]]]]]]]]]]]],[[[null,[null,0,\"Seeing [Watchdog] Socket idle for 20s in your issue led him to believe your environment was configured with a non-default 20-second threshold.\",[[7,37,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"Because 120 seconds is generally longer than the 20–40 seconds Gemini takes to output the first reasoning chunk, his reaction is: \\\"With the default 120s timeout, reasoning stalls shouldn't trigger the watchdog.\\\"\",[[130,211,[[null,null,null,null,1]]]]]]]]]]]]],[[[null,[null,0,\"Why 20 Seconds Appears Without Any Custom Configuration:\\nIf you did not pass custom timeout arguments, the 20-second threshold typically comes from one of two places in the code:\",[[0,56,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Hardcoded Internal Heartbeat\"]]]]]]]]]],1]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1003,\"Personalize\",3,null,[\"personal_recommendations\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/personal_recommendations/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
