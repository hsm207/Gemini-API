l,null,null,[[[[[null,[null,0,\"His assumption: \\\"The default watchdog is 120s, so the server has up to 2 minutes to respond.\\\"\",[[0,15,[[null,null,null,null,2]]],[16,93,[[null,null,null,null,1]]]]]]]],[[[null,[null,0,\"The reality in the code: The 120s threshold only applies when the client knows a long delay is expected (e.g., when is_thinking \\u003d\\u003d True). But because is_thinking starts uninitialized as False, the loop assumes normal token streaming should have started immediately.\",[[0,24,[[null,null,null,null,2]]],[73,78,[[null,null,null,null,1]]],[116,135,[[null,null,null,null,3]]],[150,161,[[null,null,null,null,3]]],[186,191,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"Once normal streaming is assumed, the fallback stall threshold kicks in (the 20s inactivity check). When Gemini takes 25–35 seconds to ponder life, the universe, and everything on a heavy reasoning prompt before dropping its first delta token, the 20s timer expires and nukes the connection.\"]]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"3. The Smoking Gun: is_thinking \\u003d False\",[[20,39,[[null,null,null,null,3]]]]]],[null,[null,0,\"The bug you pointed out is an architectural state machine mismatch:\"]],[null,null,null,[\"# What happens before the first chunk:\\nis_thinking \\u003d False  # \\u003c--- Starts False even if extended_thinking\\u003dTrue!\\n\\nfor chunk in response.iter_chunks():\\n    # Because is_thinking is False, stall_threshold drops to the tight 20s idle watchdog\\n    # instead of the full thinking grace period / request timeout.\\n    if socket_idle_time \\u003e stall_threshold:\\n        logger.warning(f\\\"[Watchdog] Socket idle for {stall_threshold}s. Refreshing connection...\\\")\\n        refresh_connection()\\n\",\"python\"]],[null,[null,0,\"By the time the model actually finishes reasoning and prepares candidate chunks, the client has already severed the connection and attempted a session refresh.\"]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"How to Answer His Comment\"]],[null,[null,0,\"Hit him with the distinction between the global timeout and the inner loop's stall threshold so he doesn't stay stuck on the \\\"did you set a custom timeout?\\\" tangent:\"]],[null,null,null,[\"Hi @luuquangvu,\\n\\nNo custom timeouts or client configurations were applied—this is with standard defaults.\\n\\nThe 20s in the log originates from the inner chunk loop's stall detection logic (`stall_threshold`), not the top-level request timeout. \\n\\nHere is why it triggers at ~20s:\\n1. Before any candidate deltas arrive, `is_thinking` is initialized to `False` in `client.py:1570`.\\n2. Because `is_thinking` evaluates to `False`, the stream watchdog treats the pre-token phase as an idle/dead socket rather than an active reasoning window, falling back to the 20s stall limit.\\n3. Complex prompts with `extended_thinking\\u003dTrue` routinely require 25–40s of server-side computation before emitting the first delta. Because the client has not flagged that it is awaiting reasoning output, the 20s inactivity limit fires and severs the stream prematurely.\\n\\nInitializing `is_thinking \\u003d True if extended_thinking else False` at stream setup ensures the watchdog respects the full timeout window until the first delta updates the state.\\n\",\"markdown\"]],[null,[null,0,\"That puts the focus squarely back on the code's state flow and explains why default behavior triggers the 20-second watchdog abort.\"]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,[null,null,3,null,[[1,[1791164727,782159000],1,null,[1]],[4,[1791164727,782159000],1,null,[1]],[6,[1791164727,782159000],1,null,[1]],[15,[1791164727,782159000],1,null,[1]],[20,[1791164727,782159000],1,null,[1]],[22,[1791164727,782159000],1,null,[1]],[23,[1791164727,782159000],1,null,[1]],[3,[1791164727,782159000],1,null,[1]],[5,[1791164727,782159000],1,null,[1]],[7,[1791164727,782159000],1,null,[1]],[9,[1791164727,782159000],1,null,[1]],[21,[1791164727,782159000],1,null,[1]],[35,[1791164727,782159000],1,null,[1]],[42,[1791164727,782159000],1,null,[1]],[14,[1791164727,782159000],1,null,[1]],[17,[1791164727,782159000],1,null,[1]],[2,[1791164727,782159000],1,null,[1]],[8,[1791164727,782159000],1,null,[1]],[10,[1791164727,782159000],1,null,[1]],[11,[1791164727,782159000],1,null,[1]],[12,[1791164727,782159000],1,null,[1]],[13,[1791164727,782159000],1,null,[1]],[16,[1791164727,782159000],1,null,[1]],[18,[1791164727,782159000],1,null,[1]],[19,[1791164727,782159000],1,null,[1]],[24,[1791164727,782159000],1,null,[1]],[25,[1791164727,782159000],1,null,[1]],[26,[1791164727,782159000],1,null,[1]],[27,[1791164727,782159000],1,null,[1]],[0,[1791164727,782159000],1,null,[1]],[38,[1791164727,782159000],1,null,[1]],[39,[1791164727,782159000],1,null,[1]],[40,[1791164727,782159000],1,null,[1]],[41,[1791164727,782159000],1,null,[1]]],null,[1791164727,782159000],null,false,false,0],null,null,null,1,1,null,null,null,3]"]]
