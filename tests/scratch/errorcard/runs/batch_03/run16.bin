0s\\\" Come From?\",[[14,24,[[null,null,null,null,3]]]]]],[null,[null,0,\"In gemini-webapi (especially after PRs #220, #237, and #310 touching stream retries and extended thinking):\",[[3,16,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"The global request timeout (self.timeout or curl session timeout) is configured with high maximums (or defaults around several hundred seconds) to allow large generations to finish.\",[[4,26,[[null,null,null,null,2]]],[28,40,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"Many developers / maintainers recall a stream-level idle timeout (what luuquangvu calls the \\\"watchdog\\\") set to 120s.\",[[39,64,[[null,null,null,null,2]]],[71,81,[[null,null,null,null,3]]],[111,115,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"Because 120s \\u003e 20s, luuquangvu assumed:\",[[8,18,[[null,null,null,null,2]]],[20,30,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[[null,[null,0,\"*\\\"If\"]]]]]]]]]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1003,\"Personalize\",3,null,[\"personal_recommendations\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/personal_recommendations/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
