]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Downside Risks\"]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Multiple Compression \\u0026 Tech Sentiment: Valuing SpaceX between 35x and 65x sales places it at a substantial premium compared to traditional aerospace/defense contractors (typically 1.5x–3x) and high-growth software/infrastructure firms (10x–20x). A broader macro contraction or rising cost of capital would pressure private secondary multiples.\",[[0,38,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Spectrum Allocation and Regulatory Hurdles: Direct-to-Cell services and Starlink orbital shell deployments face stringent regulatory scrutiny from the FCC, ITU, and local sovereign regulators, as well as opposition from terrestrial mobile operators.\",[[0,43,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Starship Capital Expenditure Drag: High developmental capex and potential launch anomalies could prolong cash burn before Starship achieves positive operational leverage.\",[[0,34,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Key-Person \\u0026 Governance Risk: Concentrated governance and operational dependence on Elon Musk carry ongoing headline volatility and operational cross-pressures across his broader corporate ecosystem.\",[[0,29,[[null,null,null,null,2]]]]]]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"References\"]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Sacra Research: SpaceX Valuation \\u0026 Multiples\",[[0,44,[null,[\"https://sacra.com/c/spacex/valuation/\"]]]]]]]],[[[null,[null,0,\"SatNews: SpaceX Secondary Offerings \\u0026 Market Horizon\",[[0,52,[null,[\"https://satnews.com/2025/12/06/spacex-targets-800-billion-valuation-in-secondary-sale-eyes-2026-ipo/\"]]]]]]]],[[[null,[null,0,\"MarketWise: SpaceX IPO \\u0026 Valuation Analysis\",[[0,43,[null,[\"https://marketwise.com/investing/spacex-ipo-this-rocket-company-aims-for-one-of-the-largest-ipos-ever/\"]]]]]]]],[[[null,[null,0,\"FutureSearch: SpaceX Fair Value \\u0026 Share Forecasts\",[[0,49,[null,[\"https://futuresearch.ai/spacex-ipo-valuation/\"]]]]]]]]]]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
