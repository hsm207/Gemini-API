]]]],[[[null,[null,0,\"$135 – $180\"]]]],[[[null,[null,0,\"Steady Starlink free cash flow expansion, consolidated AI revenue scaling, multiple normalization.\"]]]]]],[null,[[[[null,[null,0,\"Bull Case\",[[0,9,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$1.75T – $2.10T\",[[0,15,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$220 – $280\"]]]],[[[null,[null,0,\"Starship operationalization, accelerated direct-to-cell telecom rollouts, scarcity multiple retention.\"]]]]]]],true]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Key Upside Catalysts\"]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Starlink Cash Generation \\u0026 Direct-to-Cell Expansion\",[[0,51,[[null,null,null,null,2]]]]]],[null,[null,0,\"Starlink's consumer and enterprise subscriber base continues to provide high-margin, recurring software-like revenue. The deployment of direct-to-cell capabilities via spectrum agreements enables telco-partner monetization, broadening the addressable market beyond fixed broadband.\"]]]],[[[null,[null,0,\"Starship Cadence \\u0026 Commercial Readiness\",[[0,39,[[null,null,null,null,2]]]]]],[null,[null,0,\"Transitioning Starship into routine payload delivery dramatically reduces cost-per-kilogram to orbit compared to Falcon 9. This unlocks rapid Starlink Gen2 deployments, high-margin NASA Artemis lunar lander milestones, and defense/national security payload contracts.\"]]]],[[[null,[null,0,\"Consolidated Infrastructure \\u0026 Compute Synergies\",[[0,47,[[null,null,null,null,2]]]]]],[null,[null,0,\"Integration of advanced AI compute infrastructure and cross-entity compute demand creates an additive valuation premium beyond traditional aerospace multiples, driving multiple expansion into mega-cap tech territory.\"]]]]],1]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Downside Risks\"]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Lock-Up Expirations \\u0026 Float Expansion\",[[0,37,[[null,null,null,null,2]]]]]],[null,[null,0,\"As early investor, employee, and insider\"]]]]],1]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
