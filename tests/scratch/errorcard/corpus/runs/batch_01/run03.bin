,null,null,null,null,null,[[[[[null,[null,0,\"Post-IPO Share Float Dilution (Supply Shock): Early lock-up releases and the impending expiration of the 180-day lock-up substantially expand the tradable float. A massive influx of secondary shares from early employees and institutions poses immediate downward price pressure.\",[[0,45,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Capital Expenditure Burden \\u0026 Cash Burn: Massive ongoing CapEx requirements for Starship test programs, satellite replenishment cycles, and data infrastructure threaten operating margins and free cash flow generation.\",[[0,39,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Regulatory \\u0026 Orbital Congestion Bottlenecks: Tightened FAA environmental reviews, FCC spectrum allocation disputes, and international resistance regarding space debris and low-Earth-orbit saturation could slow launch cadences.\",[[0,44,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Multiples Compression: If revenue growth decelerates or broader macroeconomic/tech multiples contract, an equity story trading well above historical aerospace multiples faces sharp multiple contraction.\",[[0,22,[[null,null,null,null,2]]]]]]]]],1]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Sources \\u0026 References\"]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Sacra Research: SpaceX Valuation Analysis \\u0026 Revenue Scenarios\",[[0,61,[null,[\"https://sacra.com/c/spacex/valuation/\"]]]]]]]],[[[null,[null,0,\"FutureSearch: SpaceX IPO Valuation \\u0026 Fair Value Forecasts\",[[0,57,[null,[\"https://futuresearch.ai/spacex-ipo-valuation/\"]]]]]]]],[[[null,[null,0,\"Markets.com: SpaceX Target Price \\u0026 Valuation Scenarios\",[[0,54,[null,[\"https://www.markets.com/analysis/spacex-stock-price-prediction\"]]]]]]]],[[[null,[null,0,\"EBC Financial: SpaceX Valuation History \\u0026 IPO Multiples\",[[0,55,[null,[\"https://www.ebc.com/forex/spacex-ipo-in-2026-valuation-date-and-how-to-invest\"]]]]]]]]]]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
