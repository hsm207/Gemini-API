,[null,0,\"Bear Case\",[[0,9,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$780B – $1.25T\",[[0,14,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$60 – $95\"]]]],[[[null,[null,0,\"Multiples compress to 10–12x revenue; heavy Starship/AI CapEx drags margins; post-IPO lock-up expirations flood float.\"]]]]]],[null,[[[[null,[null,0,\"Base Case\",[[0,9,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$1.35T – $1.80T\",[[0,15,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$135 – $180\"]]]],[[[null,[null,0,\"Starlink ARR scales steadily; launch cadence remains near-monopoly; consolidated 2026 revenues cross ~$40B.\"]]]]]],[null,[[[[null,[null,0,\"Bull Case\",[[0,9,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$2.0T – $2.67T+\",[[0,15,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"$200 – $280\"]]]],[[[null,[null,0,\"Direct-to-cell enterprise contracts scale globally; Starship commercialization beats schedule; premium multiple sustained.\"]]]]]]],true]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Key Upside Catalysts\"]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Starlink Cash Cow \\u0026 Direct-to-Cell Monetization: Starlink represents the vast majority of recurring, high-margin revenue. Accelerated adoption of direct-to-cell services (following the integration of EchoStar spectrum) and enterprise maritime/aviation agreements provide clear recurring cash flows.\",[[0,48,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Starship Operational Milestones: Demonstration of rapid Starship reusability, in-orbit refueling, and progress toward NASA Artemis HLS deliverables will derisk long-term deep-space operations and significantly compress per-kilogram launch costs.\",[[0,32,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Space-Based AI \\u0026 Cloud Infrastructure: Commercial monetization of orbital computing architectures and data networking contracts (e.g., partnerships with hyperscalers) could unlock software-like valuation multiples rather than standard aerospace hardware multiples.\",[[0,38,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Defense \\u0026 Government Moats: Dominance in national security launches, secure orbital networks (Starshield), and expanded NASA cargo/crew contract extensions ensure stable, non-cyclical revenue floors.\",[[0,27,[[null,null,null,null,2]]]]]]]]],1]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Downside Risks \\u0026 Valuation Drags\"]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Post-IPO Share Float Dilution (Supply Shock): Early lock-up releases and the impending expiration of the 180-day lock-up substantially expand the tradable float\",[[0,45,[[null,null,null,null,2]]]]]]]]],1]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
