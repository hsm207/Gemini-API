[["wrb.fr",null,"[null,[\"c_9d29c148b586d5b3\",\"r_cc492c3dbf64c1ef\"],null,null,[[\"rc_dd7212b22c55288f\",[\"Expert consensus on SpaceX's valuation for late 2026 establishes a wide target range, driven by whether analysts frame the company as an aerospace/telecom provider or as a multi-trillion-dollar infrastructure and AI compute conglomerate.\\n\\n---\\n\\n### Valuation Ranges (Year-End 2026)\\n\\n| Scenario | Implied Valuation / Market Cap | Implied Multiple / Benchmark | Primary Drivers |\\n| :--- | :--- | :--- | :--- |\\n| **Bear Case / DCF Anchor** | **$780B – $1.25T** | 20× – 30× P/S (~$40B–$45B run-rate) | Scarcity premium erosion, post-IPO lockup expirations, launch cadence plateaus. |\\n| **Base Case (Consensus)** | **$1.35T – $1.80T** | ~35× – 45× forward P/S | Steady Starlink subscriber growth, commercial direct-to-cell scaling, stable Falcon cadence. |\\n| **Bull Case (Aggressive Expansion)** | **$2.0T – $2.6T+** | \\u003e50× forward P/S | Starship operationalization, orbital data centers/AI compute integration, defense contracts. |\\n\\n---\\n\\n### Key Upside Catalysts\\n\\n1. **Starlink Scaling \\u0026 Direct-to-Cell Monetization:** Continued subscriber adoption past the 8–10 million mark, paired with commercial direct-to-cell telecom rollouts and high-margin enterprise/maritime/aviation contracts, generates predictable recurring revenue.\\n2. **Starship Operational Milestones:** Transitioning Starship from test flights to routine orbital payload delivery will dramatically reduce cost-per-kilogram to orbit, accelerating constellation deployment and unlocking deep-space government payloads.\\n3. **Space-Based AI \\u0026 Distributed Compute Infrastructure:** Aggressive market speculation around orbital compute nodes, proprietary\"],null,null,null,null,null,null,[1],\"en\",null,null,[null,null,null,null,null,null,null,[]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[],null,null,null,null,null,null,null,null,[null,[[[],\"Searched the web\",\"Google Search\",\"https://www.gstatic.com/images/branding/productlogos/googleg/v6/192px.svg\",[],\"Searched the web\",\"\",[[\"https://t2.gstatic.com/faviconV2?url\\u003dhttps://sacra.com/\\u0026client\\u003dBARD\\u0026type\\u003dFAVICON\\u0026size\\u003d256\\u0026fallback_opts\\u003dTYPE,SIZE,URL\",\"https://sacra.com/c/spacex/valuation/\",\"SpaceX: $800.00B valuation [2026] - Sacra\",null,[]],[\"https://t3.gstatic.com/faviconV2?url\\u003dhttps://satnews.com/\\u0026client\\u003dBARD\\u0026type\\u003dFAVICON\\u0026size\\u003d256\\u0026fallback_opts\\u003dTYPE,SIZE,URL\",\"https://satnews.com/2025/12/06/spacex-targets-800-billion-valuation-in-secondary-sale-eyes-2026-ipo/\",\"SpaceX Targets $800 Billion Valuation in Secondary Sale, Eyes\",null,[]],[\"https://t2.gstatic.com/faviconV2?url\\u003dhttps://www.ebc.com/\\u0026client\\u003dBARD\\u0026type\\u003dFAVICON\\u0026size\\u003d256\\u0026fallback_opts\\u003dTYPE,SIZE,URL\",\"https://www.ebc.com/forex/spacex-ipo-in-2026-valuation-date-and-how-to-invest\",\"SpaceX IPO in 2026? Valuation, Date and How to Invest\",null,[]],[\"https://t1.gstatic.com/faviconV2?url\\u003dhttps://www.markets.com/\\u0026client\\u003dBARD\\u0026type\\u003dFAVICON\\u0026size\\u003d256\\u0026fallback_opts\\u003dTYPE,SIZE,URL\",\"https://www.markets.com/analysis/spacex-stock-price-prediction\",\"SpaceX Stock Price Prediction 2026, 2027, 2030 \\u0026 2040\",null,[]],[\"https://t2.gstatic.com/faviconV2?url\\u003dhttps://futuresearch.ai/\\u0026client\\u003dBARD\\u0026type\\u003dFAVICON\\u0026size\\u003d256\\u0026fallback_opts\\u003dTYPE,SIZE,URL\",\"https://futuresearch.ai/spacex-ipo-valuation/\",\"SpaceX IPO Price and Stock Forecast to 2027 - FutureSearch.ai\",null,[]],[\"https://t2.gstatic.com/faviconV2?url\\u003dhttps://www.fool.com/\\u0026client\\u003dBARD\\u0026type\\u003dFAVICON\\u0026size\\u003d256\\u0026fallback_opts\\u003dTYPE,SIZE,URL\",\"https://www.fool.com/investing/2026/09/29/prediction-spacex-stock-worth-this-much-