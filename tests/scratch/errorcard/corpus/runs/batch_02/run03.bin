Compute \\u0026 AI Infrastructure Speculation:\",[[0,48,[[null,null,null,null,2]]]]]],[null,[null,0,\"The most aggressive Wall Street bull cases (e.g., Morgan Stanley's extended targets) factor in emerging optionality around orbital edge-compute nodes, secure low-latency space data networks, and defense surveillance systems.\"]]]]],1]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Key Down\"]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
