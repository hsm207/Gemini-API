],[\"Change Ordering\",1.5318187E-4],[\"Change Structure\",3.385917E-4],[\"Adopt Persona\",2.9171418E-4],[\"Change Tone\",8.265437E-6],[\"Rhyme\",9.908769E-7],[\"Change to Specific Audience\",7.9675745E-5],[\"Change Tone / Style\",4.7403865E-4],[\"Rephrase\",1.08849774E-4],[\"Simplify / Condense\",6.442869E-5],[\"Factual / Logical Correction\",6.561896E-4],[\"Attribute-Specific Correction\",0.0013653537],[\"Pushback Circumvention\",5.8011112E-5],[\"Constraint Re-Statement\",1.9027376E-4],[\"Exact Resubmission\",3.0090884E-4],[\"Expand / Elaborate\",0.00438957],[\"Revise\",4.4427594E-4]],[[\"Positive\",0.005601703],[\"Negative\",0.004048012]]]],null,[[[[null,[null,0,\"Let's dive straight into how the timeouts and watchdog mechanics are configured in the Gemini-API codebase so you can see exactly where that 20 seconds comes from without any guesswork.\",[[87,97,[[null,null,null,null,3]]],[141,151,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"The Timeout Architecture in Gemini-API\",[[28,38,[[null,null,null,null,3]]]]]],[null,[null,0,\"In Gemini-API (specifically client.py and its connection settings), there are actually two distinct watchdog / timeout layers that interact during streaming:\",[[3,13,[[null,null,null,null,3]]],[28,37,[[null,null,null,null,3]]],[87,125,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,[[[null,[[[[null,[null,0,\"Parameter / Mechanic\"]]]],[[[null,[null,0,\"Where It Applies\"]]]],[[[null,[null,0,\"Default Value\"]]]],[[[null,[null,0,\"Role \\u0026 Behavior\"]]]]]],[null,[[[[null,[null,0,\"Stream Chunk / Idle Watchdog\",[[0,28,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Inside the inner stream parsing loop (_generate())\",[[38,49,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"20 seconds (or derived from default socket read slices)\",[[0,2,[[null,null,null,null,3]]],[0,10,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Monitors interval between incoming byte/data deltas. Drops and attempts socket reconnection if no bytes arrive.\"]]]]]],[null,[[[[null,[null,0,\"Global Request Timeout\",[[0,22,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Client-level / HTTP transport (timeout)\",[[31,38,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"120s – 450s\",[[0,4,[[null,null,null,null,3]]],[7,11,[[null,null,null,null,3]]],[0,11,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"The ceiling for the total HTTP roundtrip / stream completion.\"]]]]]]],true]],[null,[null,0,\"Maintainers often confuse the high-level client timeout (e.g. timeout: int \\u003d 120 or 450 in client initialization) with the low-level chunk loop watchdog running inside the generator.\",[[30,55,[[null,null,null,null,2]]],[62,80,[[null,null,null,null,3]]],[84,87,[[null,null,null,null,3]]],[123,152,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Why You Saw 20s Without Customizing Anything\"]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"The 20-Second Default Idle Window:\",[[0,34,[[null,null,null,null,2]]]]]],[null,[null,0,\"Inside the streaming chunk generator loop, the client guards against half-open or dropped TCP connections by enforcing a per-chunk idle deadline. When no explicit override is passed, the loop checks for chunk delivery with an internal watchdog slice that defaults to 20 seconds (logging [Watchdog] Socket idle for 20s. Refreshing connection...).\",[[267,277,[[null,null,null,null,2]]],[287,343,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"The is_thinking Initial State Trap:\",[[4,15,[[null,null,null,null,3]]],[0,35,[[null,null,null,null,2]]]]]],[null,[null,0,\"In client.py (around line 1570), is_thinking is initialized unconditionally to False:\",[[3,12,[[null,null,null,null,3]]],[33,44,[[null,null,null,null,3]]],[79,84,[[null,null,null,null,3]]]]]],[null,null,null,[\"is_thinking \\u003d False\\n\",\"python\"]],[null,[null,0,\"The stall threshold logic evaluates:\"]],[null,null,null,[\"stall_threshold \\u003d self.timeout if is_thinking else min(self.timeout, self.watchdog_timeout)\\n\",\"python\"]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"Since is_thinking starts as False, the threshold immediately collapses to min(self.timeout, 20) \\u003d 20 seconds.\",[[6,17,[[null,null,null,null,3]]],[28,33,[[null,null,null,null,3]]],[74,95,[[null,null,null,null,3]]],[98,108,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"During extended reasoning (especially on complex chain-of-thought prompts), the server can easily take 25 to 45 seconds before flushing the initial thinking chunk or payload header.\",[[103,119,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"The loop reaches 20 seconds of silence, decides the socket is abandoned, and severs the connection.\"]]]]]]]]],[[[null,[null,0,\"Why luuquangvu Got Confused:\",[[4,14,[[null,null,null,null,3]]],[0,28,[[null,null,null,null,2]]]]]],[null,[null,0,\"He was likely looking only at the default argument on the client class constructor (e.g., watchdog_timeout\\u003d120 in a newer or alternate branch, or conflating the request timeout) and didn't check the hardcoded or sub-slice fallback in the streaming generator that defaults to 20s when parsing chunks.\",[[90,110,[[null,null,null,null,3]]]]]]]]],1]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"Suggested Reply to Set the Record Straight\"]],[null,null,null,[\"Hi @luuquangvu,\\n\\nTo clarify: no custom timeout was configured on my end; this is occurring out of the box. \\n\\nInside the streaming chunk loop in `client.py`, the idle slice before candidate deltas arrive triggers at 20 seconds. Because `is_thinking` is initialized to `False` at line 1570:\\n\\n```python\\nis_thinking \\u003d False\\n\",\"markdown\"]],[null,[null,0,\"The loop treats the initial reasoning silence as an idle socket:\"]],[null,null,null,[\"stall_threshold \\u003d self.timeout if is_thinking else min(self.timeout, self.watchdog_timeout)\\n\",\"python\"]],[null,[null,0,\"Because is_thinking is False, stall_threshold evaluates to min(self.timeout, self.watchdog_timeout) (20s) instead of self.timeout. When the model spends \\u003e20s on its initial reasoning phase before emitting the first delta, the watchdog mistakes server-side thinking for an abandoned connection and closes the stream.\",[[8,19,[[null,null,null,null,3]]],[23,28,[[null,null,null,null,3]]],[30,45,[[null,null,null,null,3]]],[59,99,[[null,null,null,null,3]]],[117,129,[[null,null,null,null,3]]]]]],[null,[null,0,\"Initializing is_thinking \\u003d True if extended_thinking else False resolves this cleanly by allowing the stream to respect self.timeout during that initial thinking window.\",[[13,63,[[null,null,null,null,3]]],[120,132,[[null,null,null,null,3]]]]]],[null,null,null,[\"\",\"\"]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
