[\"Expand / Elaborate\",0.00438957],[\"Revise\",4.4427594E-4]],[[\"Positive\",0.005601703],[\"Negative\",0.004048012]]]],null,[[[[null,[null,0,\"Let's dive straight into how the timeouts and watchdog mechanics are configured in the Gemini-API codebase so you can see exactly where that 20 seconds comes from without any guesswork.\",[[87,97,[[null,null,null,null,3]]],[141,151,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"The Timeout Architecture in Gemini-API\",[[28,38,[[null,null,null,null,3]]]]]],[null,[null,0,\"In Gemini-API (specifically client.py and its connection settings), there are actually two distinct watchdog / timeout layers that interact during streaming:\",[[3,13,[[null,null,null,null,3]]],[28,37,[[null,null,null,null,3]]],[87,125,[[null,null,null,null,2]]]]]],[null,null,null,null,null,null,null,null,null,null,[[[null,[[[[null,[null,0,\"Parameter / Mechanic\"]]]],[[[null,[null,0,\"Where It Applies\"]]]],[[[null,[null,0,\"Default Value\"]]]],[[[null,[null,0,\"Role \\u0026 Behavior\"]]]]]],[null,[[[[null,[null,0,\"Stream Chunk / Idle Watchdog\",[[0,28,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Inside the inner stream parsing loop (_generate())\",[[38,49,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"20 seconds (or derived from default socket read slices)\",[[0,2,[[null,null,null,null,3]]],[0,10,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Monitors interval between incoming byte/data deltas. Drops and attempts socket reconnection if no bytes arrive.\"]]]]]],[null,[[[[null,[null,0,\"Global Request Timeout\",[[0,22,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Client-level / HTTP transport (timeout)\",[[31,38,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"120s – 450s\",[[0,4,[[null,null,null,null,3]]],[7,11,[[null,null,null,null,3]]],[0,11,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"The ceiling for the total HTTP roundtrip / stream 