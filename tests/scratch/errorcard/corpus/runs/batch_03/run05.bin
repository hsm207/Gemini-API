23]]]],null,[[[[null,[null,0,\"Here is what is going on in the gemini-webapi codebase regarding that 20-second watchdog and why luuquangvu's comment contradicts what you are seeing.\",[[32,45,[[null,null,null,null,3]]],[97,107,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,[null,3,\"1. Where Does 20 Seconds Come From?\"]],[null,[null,0,\"In the upstream repository (HanaokaYuzu/Gemini-API / gemini-webapi), there are actually two distinct timeout concepts that frequently get conflated:\",[[28,50,[[null,null,null,null,3]]],[53,66,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"The HTTP/Session-level timeout: This is typically set generously (e.g., 120s–450s) on the underlying httpx or curl_cffi client. This is what luuquangvu is referencing when he says:\",[[0,31,[[null,null,null,null,2]]],[101,106,[[null,null,null,null,3]]],[110,119,[[null,null,null,null,3]]],[141,151,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[[null,[null,0,\"\\\"the default watchdog timeout is 120 seconds, while the default request timeout is 450 seconds.\\\"\",[[0,96,[[null,null,null,null,1]]]]]]]]]]],[[[null,[null,0,\"The In-Flight Chunk/Stall Watchdog: When consuming the server-sent events (SSE) or streaming chunks in _generate(), the stream reader implements an active watchdog to detect stalled or half-closed TCP sockets.\",[[0,35,[[null,null,null,null,2]]],[103,114,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,[[[[[null,[null,0,\"In several revisions and streaming implementations of the client, the idle chunk loop enforces an internal stall interval—often hardcoded or defaulting to 15–20 seconds (or calculating min(timeout, stall_interval)).\",[[155,168,[[null,null,null,null,2]]],[185,213,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"If no raw byte chunk / delta arrives over the wire within that window, the loop assumes the connection hung and forces a disconnect or connection refresh:\"]]]]]]]]]],1]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
