en hardcoded or defaulting to 15–20 seconds (or calculating min(timeout, stall_interval)).\",[[155,168,[[null,null,null,null,2]]],[185,213,[[null,null,null,null,3]]]]]]]],[[[null,[null,0,\"If no raw byte chunk / delta arrives over the wire within that window, the loop assumes the connection hung and forces a disconnect or connection refresh:\"]],[null,null,null,[\"[Watchdog] Socket idle for 20s. Refreshing connection...\\n\",\"text\"]]]]]]]]]],1]],[null,[null,0,\"Because you didn't customize any timer settings, your log message proves that a 20-second threshold\"]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1002,\"Don't personalize\",2,null,[\"person_cancel\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/person_cancel/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
