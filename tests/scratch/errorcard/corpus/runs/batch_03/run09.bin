[[[[[null,[null,0,\"Default overall request / session stream timeout: 450s.\",[[0,49,[[null,null,null,null,2]]]]]]]],[[[null,[null,0,\"Default stream watchdog / zombie stall timeout: 120s.\",[[0,47,[[null,null,null,null,2]]]]]]]]]]],[null,[null,0,\"Because he authored those numbers, in his mind the watchdog is hardcoded or defaulted to wait 120 seconds before deciding a stream has stalled. When he saw your log:\",[[94,105,[[null,null,null,null,2]]]]]],[null,null,null,[\"[Watchdog] Socket idle for 20s. Refreshing connection...\\n\",\"\"]],[null,[null,0,\"he immediately assumed:\"]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[[null,[null,0,\"*\\\"Wait, if my watchdog default is 120s, why on earth did your socket abort after only 20 seconds? You must have passed a 20s watchdog setting or broken configuration\"]]]]]]]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,\"3.8 Flash\",true,[[[[1004,\"Longer\",5,null,[\"expand\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\",null,true]],[1005,\"Shorter\",6,null,[\"compress\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\",null,true]],[1003,\"Personalize\",3,null,[\"personal_recommendations\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/personal_recommendations/default/24px.svg\",null,true]],[1001,\"Try again\",1,null,[\"refresh\",\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,1,1]"]]
